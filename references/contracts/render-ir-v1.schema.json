{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sublation:litigation-visualization:render-ir:1.0",
  "title": "Closed litigation visualization RenderIR (spec-only)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "render_id",
    "release_class",
    "layout",
    "time_semantics",
    "visual_mode",
    "engine",
    "sources",
    "privacy",
    "checkpoint",
    "layout_data",
    "scene"
  ],
  "properties": {
    "schema_version": { "const": "render-ir/1.0" },
    "render_id": { "$ref": "#/$defs/id" },
    "release_class": { "enum": ["draft", "final_candidate"] },
    "layout": { "$ref": "#/$defs/layout" },
    "time_semantics": { "enum": ["ordinal", "dated", "interval", "not_applicable"] },
    "visual_mode": { "$ref": "#/$defs/visual_mode" },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "deterministic", "network_access"],
      "properties": {
        "id": { "enum": ["renderir-native-v1", "graphviz-dot-v1", "graphviz-neato-v1"] },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "deterministic": { "const": true },
        "network_access": { "const": false }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "privacy": { "$ref": "#/$defs/privacy" },
    "checkpoint": { "$ref": "#/$defs/checkpoint" },
    "layout_data": { "$ref": "#/$defs/layout_data" },
    "scene": { "$ref": "#/$defs/scene" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "layout": {
      "enum": [
        "numbered_point_timeline",
        "dated_point_timeline",
        "proportional_gantt",
        "graphviz_flow",
        "graphviz_relation",
        "relation_tree",
        "comparison_table"
      ]
    },
    "visual_mode": { "enum": ["qichuan", "guizang", "baimiao"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "sha256", "data_class", "frozen"],
      "properties": {
        "source_id": { "$ref": "#/$defs/id" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "data_class": { "enum": ["synthetic", "deidentified"] },
        "frozen": { "const": true }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_class",
        "real_case_data",
        "minimization_status",
        "input_scan",
        "output_scan_required"
      ],
      "properties": {
        "data_class": { "enum": ["synthetic", "deidentified"] },
        "real_case_data": { "const": false },
        "minimization_status": { "const": "approved" },
        "input_scan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "scanner_version", "input_sha256"],
          "properties": {
            "status": { "const": "pass" },
            "scanner_version": { "type": "string", "minLength": 1, "maxLength": 64 },
            "input_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "output_scan_required": { "const": true }
      }
    },
    "checkpoint_choice": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["question_id", "candidates", "selected"],
          "properties": {
            "question_id": { "const": "layout" },
            "candidates": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/layout" }
            },
            "selected": {
              "oneOf": [
                { "$ref": "#/$defs/layout" },
                { "type": "null" }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["question_id", "candidates", "selected"],
          "properties": {
            "question_id": { "const": "visual_mode" },
            "candidates": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/visual_mode" }
            },
            "selected": {
              "oneOf": [
                { "$ref": "#/$defs/visual_mode" },
                { "type": "null" }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["question_id", "candidates", "selected"],
          "properties": {
            "question_id": { "const": "emphasis" },
            "candidates": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "anyOf": [
                  { "const": "none" },
                  { "$ref": "#/$defs/id" }
                ]
              }
            },
            "selected": {
              "anyOf": [
                { "const": "none" },
                { "$ref": "#/$defs/id" },
                { "type": "null" }
              ]
            }
          }
        }
      ]
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "status", "questions", "receipt_id", "finalization_allowed"],
      "properties": {
        "version": { "const": "checkpoint/1.0" },
        "status": { "enum": ["pending", "confirmed"] },
        "questions": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/checkpoint_choice" }
        },
        "receipt_id": { "type": ["string", "null"], "maxLength": 128 },
        "finalization_allowed": { "type": "boolean" }
      }
    },
    "locator": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "page", "paragraph", "bbox"],
          "properties": {
            "kind": { "const": "page_paragraph_bbox" },
            "page": { "type": "integer", "minimum": 1 },
            "paragraph": { "type": "string", "minLength": 1, "maxLength": 128 },
            "bbox": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": { "type": "number", "minimum": 0 }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "stable_locator" },
            "value": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_sha256",
        "locator",
        "original_text_sha256",
        "extracted_text_sha256",
        "display_text_sha256"
      ],
      "properties": {
        "source_id": { "$ref": "#/$defs/id" },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "locator": { "$ref": "#/$defs/locator" },
        "original_text_sha256": { "$ref": "#/$defs/sha256" },
        "extracted_text_sha256": { "$ref": "#/$defs/sha256" },
        "display_text_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height", "rotation", "z_index"],
      "properties": {
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "rotation": { "type": "number", "minimum": -360, "maximum": 360 },
        "z_index": { "type": "integer", "minimum": 0 }
      }
    },
    "text_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_text",
        "display_text_sha256",
        "text_complete",
        "overflow_policy",
        "negation_preserved",
        "qualifier_preserved"
      ],
      "properties": {
        "display_text": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "display_text_sha256": { "$ref": "#/$defs/sha256" },
        "text_complete": { "const": true },
        "overflow_policy": { "const": "fail_closed" },
        "negation_preserved": { "const": true },
        "qualifier_preserved": { "const": true }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["element_id", "kind", "geometry", "emphasis", "provenance"],
      "properties": {
        "element_id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["text", "shape", "line", "group", "table_cell"] },
        "geometry": { "$ref": "#/$defs/geometry" },
        "line_endpoints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x1", "y1", "x2", "y2"],
          "properties": {
            "x1": { "type": "number", "minimum": 0 },
            "y1": { "type": "number", "minimum": 0 },
            "x2": { "type": "number", "minimum": 0 },
            "y2": { "type": "number", "minimum": 0 }
          }
        },
        "text": { "$ref": "#/$defs/text_contract" },
        "emphasis": { "enum": ["none", "human_confirmed"] },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/provenance" }
        }
      }
    },
    "comparison_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["column_ids", "row_ids"],
      "properties": {
        "column_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/id" }
        },
        "row_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "element_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["element_id"],
      "properties": {
        "element_id": { "$ref": "#/$defs/id" }
      }
    },
    "graph_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["element_id", "from", "to"],
      "properties": {
        "element_id": { "$ref": "#/$defs/id" },
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" }
      }
    },
    "ordinal_axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin_x", "points_per_ordinal", "tolerance_pt"],
      "properties": {
        "origin_x": { "type": "number", "minimum": 0 },
        "points_per_ordinal": { "type": "number", "exclusiveMinimum": 0 },
        "tolerance_pt": { "type": "number", "minimum": 0, "maximum": 0.5 }
      }
    },
    "date_axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin_date", "origin_x", "points_per_day", "tolerance_pt"],
      "properties": {
        "origin_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "origin_x": { "type": "number", "minimum": 0 },
        "points_per_day": { "type": "number", "exclusiveMinimum": 0 },
        "tolerance_pt": { "type": "number", "minimum": 0, "maximum": 0.5 }
      }
    },
    "layout_data": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "axis", "events"],
          "properties": {
            "kind": { "const": "ordinal_events" },
            "axis": { "$ref": "#/$defs/ordinal_axis" },
            "events": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["element_id", "ordinal"],
                "properties": {
                  "element_id": { "$ref": "#/$defs/id" },
                  "ordinal": { "type": "integer", "minimum": 1 }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "axis", "events"],
          "properties": {
            "kind": { "const": "dated_events" },
            "axis": { "$ref": "#/$defs/date_axis" },
            "events": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["element_id", "date"],
                "properties": {
                  "element_id": { "$ref": "#/$defs/id" },
                  "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "axis", "spans"],
          "properties": {
            "kind": { "const": "interval_spans" },
            "axis": { "$ref": "#/$defs/date_axis" },
            "spans": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["element_id", "start_date", "end_date"],
                "properties": {
                  "element_id": { "$ref": "#/$defs/id" },
                  "start_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
                  "end_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "edges"],
          "properties": {
            "kind": { "const": "flow_edges" },
            "edges": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/graph_edge" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "edges"],
          "properties": {
            "kind": { "const": "relation_edges" },
            "edges": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/graph_edge" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "root_element_id", "edges"],
          "properties": {
            "kind": { "const": "tree_edges" },
            "root_element_id": { "$ref": "#/$defs/id" },
            "edges": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/graph_edge" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "column_ids", "row_ids", "cells"],
          "properties": {
            "kind": { "const": "comparison_cells" },
            "column_ids": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "$ref": "#/$defs/id" }
            },
            "row_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
            "cells": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["element_id", "column_id", "row_id"],
                "properties": {
                  "element_id": { "$ref": "#/$defs/id" },
                  "column_id": { "$ref": "#/$defs/id" },
                  "row_id": { "$ref": "#/$defs/id" }
                }
              }
            }
          }
        }
      ]
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_graph_sha256", "coordinate_system", "canvas", "elements"],
      "properties": {
        "scene_graph_sha256": { "$ref": "#/$defs/sha256" },
        "coordinate_system": { "const": "top-left-points" },
        "canvas": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height", "unit"],
          "properties": {
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 },
            "unit": { "const": "pt" }
          }
        },
        "elements": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/element" }
        },
        "comparison": { "$ref": "#/$defs/comparison_contract" }
      }
    }
  }
}
