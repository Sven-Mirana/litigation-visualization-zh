            "relationship",
            "timeline",
            "evidence_matrix",
            "stage_risk",
            "next_steps",
            "scope"
          ]
        },
        "title": { "$ref": "#/$defs/short_text" },
        "source_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "content": { "type": "object" }
      }
    },
    "contains_cover": {
      "properties": {
        "slides": {
          "contains": { "properties": { "role": { "const": "cover" } }, "required": ["role"] },
          "minContains": 1
        }
      }
    },
    "contains_executive_summary": {
