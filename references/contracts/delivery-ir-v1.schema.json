          "minContains": 1
        }
      }
    },
    "contains_timeline": {
      "properties": {
        "slides": {
          "contains": { "properties": { "role": { "const": "timeline" } }, "required": ["role"] },
          "minContains": 1
        }
      }
    },
    "contains_evidence_matrix": {
      "properties": {
        "slides": {
          "contains": { "properties": { "role": { "const": "evidence_matrix" } }, "required": ["role"] },
          "minContains": 1
        }
      }
    },
    "contains_stage_risk": {
      "properties": {
        "slides": {
          "contains": { "properties": { "role": { "const": "stage_risk" } }, "required": ["role"] },
          "minContains": 1
        }
      }
    },
    "contains_next_steps": {
      "properties": {
        "slides": {
          "contains": { "properties": { "role": { "const": "next_steps" } }, "required": ["role"] },
          "minContains": 1
        }
      }
    },
    "contains_scope": {
      "properties": {
        "slides": {
          "contains": { "properties": { "role": { "const": "scope" } }, "required": ["role"] },
          "minContains": 1
        }
      }
    },
    "slide": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/slide_base" },
            {
              "properties": {
                "role": { "const": "cover" },
                "content": { "$ref": "#/$defs/cover_content" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/slide_base" },
            {
              "properties": {
                "role": { "const": "executive_summary" },
                "content": { "$ref": "#/$defs/executive_summary_content" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/slide_base" },
            {
              "properties": {
                "role": { "const": "relationship" },
                "content": { "$ref": "#/$defs/relationship_content" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/slide_base" },
            {
              "properties": {
                "role": { "const": "timeline" },
                "content": { "$ref": "#/$defs/timeline_content" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/slide_base" },
            {
              "properties": {
                "role": { "const": "evidence_matrix" },
                "content": { "$ref": "#/$defs/evidence_matrix_content" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/slide_base" },
            {
